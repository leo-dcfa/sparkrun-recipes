# Environment for Step-3.7-Flash NVFP4 recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/MiaAI-Lab/Dual-DGX-Spark-Step-3.7-Flash-NVFP4
#
# Mirrors the `env:` block of step-3.7-flash-nvfp4.yaml. Per-node vars
# (NCCL_IB_HCA, NCCL_SOCKET_IFNAME, GLOO_SOCKET_IFNAME, node ranks) are set by
# sparkrun.

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Homelab NCCL RoCE set (CX-7 direct link; GID 3, not MiaAI's example 0) ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
