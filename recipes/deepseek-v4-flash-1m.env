# Environment for DeepSeek-V4-Flash fp8+MTP 1M recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/MiaAI-Lab/DeepSeek-V4-Flash-Dual-DGX-Spark-1M-Context
#
# Mirrors the `env:` block of deepseek-v4-flash-1m.yaml. Per-node coordination
# vars (NODE_RANK, MASTER_ADDR, HEADLESS, NCCL_IB_HCA, NCCL_SOCKET_IFNAME) are
# set by sparkrun, not here. No HF_TOKEN (sparkrun doesn't interpolate env
# values; containers run HF-offline — cache must be warm on BOTH nodes).

VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Homelab standards ---
# NB: no VLLM_WORKER_MULTIPROC_METHOD=fork on this image — worker CUDA init
# fails under fork on the 0.21-era build (see yaml). Default spawn works.
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# --- NCCL over the ConnectX-7 / IB-RoCE link ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
