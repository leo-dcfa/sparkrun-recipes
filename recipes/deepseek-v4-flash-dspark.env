# Environment for DeepSeek-V4-Flash + DSpark recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
#
# Mirrors the `env:` block of deepseek-v4-flash-dspark.yaml — VERBATIM defaults
# from MiaAI's docker-compose.dspark.yml. Do NOT prune the VLLM_DSPARK_* /
# VLLM_B12X_* switches: dropping them produced garbled decode output
# (verified 2026-07-23). Keep the two files in sync.
#
# Per-node vars (NODE_RANK, MASTER_ADDR, HEADLESS, NCCL_IB_HCA,
# NCCL_SOCKET_IFNAME, VLLM_HOST_IP) are set by sparkrun, not here. No HF_TOKEN
# (sparkrun doesn't interpolate env values; containers run HF-offline).

# --- HF / caches ---
HF_HUB_DISABLE_XET=1
VLLM_CACHE_ROOT=/cache/huggingface/vllm-cache

# --- DSpark long-context crash fix kill-switch ---
DSPARK_SLOT_CLAMP=1

# --- vLLM runtime ---
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_TRITON_MLA_SPARSE=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
VLLM_SKIP_INIT_MEMORY_CHECK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- FlashInfer sampler + B12X MoE (garble fix + speed) ---
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
B12X_W4A16_TC_DECODE=0

# --- DSpark drafter switches (anti-garble set) ---
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP=1
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE_EXACT=0

# --- CUDA arch / JIT (GB10 = sm_121a) ---
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/flashinfer
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

# --- NCCL over the ConnectX-7 / IB-RoCE link ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# --- Homelab addition (not in MiaAI compose) ---
VLLM_WORKER_MULTIPROC_METHOD=fork
