# Environment for DeepSeek-V4-Flash-Vision-Exp + DSpark recipe (DGX Spark GB10, 2 nodes)
# Source: tonyd2wild's vision-exp-default branch, adopted 2026-09-01; re-synced
#         2026-09-03 to main @ 9bf6e53 (+VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS) —
# https://github.com/tonyd2wild/DeepSeek-v4-Flash-Vision-Exp-DSpark-1M-NVFP4-KV-2x-DGX-Spark
#
# Mirrors the `env:` block of deepseek-v4-flash-vision-exp.yaml — keep the two
# files in sync. This is the 0731 switch set (deepseek-v4-flash-0731.env) minus
# the two E15 drafter switches: VLLM_DSPARK_FUSED_MARKOV_ARGMAX is 0 and
# VLLM_DSPARK_DRAFT_CAPTURE_SIZES is dropped — the E15 wins were measured on
# the 1-layer 0731 drafter; this checkpoint's drafter is 3 layers and
# upstream's vision profile runs both off. Re-sweep before re-enabling.
#
# Per-node vars (NODE_RANK, MASTER_ADDR, HEADLESS, NCCL_IB_HCA,
# NCCL_SOCKET_IFNAME, VLLM_HOST_IP) are set by sparkrun, not here.
#
# Deliberate diffs vs upstream's ds4-vision-tp2.sh launcher (their probe-c
# image needs switches the stage-c stack does not — see the yaml header):
#   - no DSPARK_SLOT_CLAMP / VLLM_TRITON_MLA_SPARSE /
#     VLLM_DSPARK_HARDWARE_SCHEDULER_EARLY_STOP
#   - no VLLM_ALLOW_LONG_MAX_MODEL_LEN (ctx stays at the 1M YaRN ceiling)

# --- HF / caches ---
HF_HUB_DISABLE_XET=1
VLLM_CACHE_ROOT=/cache/huggingface/vllm-cache-vision-exp
TRITON_CACHE_DIR=/cache/huggingface/jitcache/triton
TORCH_EXTENSIONS_DIR=/cache/huggingface/jitcache/torch_extensions
VLLM_CACHE_DIR=/cache/huggingface/jitcache/vllm
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/jitcache/flashinfer
TVM_FFI_CACHE_DIR=/cache/huggingface/jitcache/tvm-ffi
XDG_CACHE_HOME=/cache/huggingface/jitcache

# --- vLLM runtime ---
VLLM_ENGINE_READY_TIMEOUT_S=5400
# inference-time RPC deadline (boot is covered by ENGINE_READY above) — see yaml
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_USE_FLASHINFER_SAMPLER=1

# --- B12X / DSpark ---
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
B12X_W4A16_TC_DECODE=0
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0

# --- JIT / arch ---
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc

# --- NCCL / RoCE ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
