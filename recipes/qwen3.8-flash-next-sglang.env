# Environment for the Qwen3.8-Flash-Next NVFP4 SGLang recipe (DGX Spark GB10, 2 nodes)
# Source: tonyd2wild/Qwen3.8-Flash-Next-NVFP4-DGX-Spark launch-qwen38fn-sglang-tp2.sh
#         @ b515104, adopted 2026-09-03.
#
# Mirrors the `env:` block of qwen3.8-flash-next-sglang.yaml — keep the two in
# sync. Per-node vars (NCCL_IB_HCA, NCCL_SOCKET_IFNAME, GLOO_SOCKET_IFNAME, node
# ranks, dist-init-addr) are set by sparkrun, not here.
#
# Not carried from upstream: LD_PRELOAD=/opt/nccl/libnccl.so.2 (their NCCL 2.30.4
# bind-mount) — NCCL >= 2.30 is baked into the local image instead; HF_HOME /
# HF_HUB_CACHE (sparkrun mounts the HF cache at /cache/huggingface and sets
# HF_HOME itself).

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# --- NCCL RoCE set (upstream launcher values) ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_MAX_NCHANNELS=4
NCCL_MIN_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
