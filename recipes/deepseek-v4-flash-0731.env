# Environment for DeepSeek-V4-Flash-0731 + DSpark recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/tonyd2wild/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark
#
# Mirrors the `env:` block of deepseek-v4-flash-0731.yaml — keep the two files
# in sync. This is tonyd2wild's 0731 switch set (the DSPARK_*/B12X_* anti-garble
# set carries over from the pre-0731 lanes; dropping switches from that family
# produced garbled decode on 2026-07-23 — don't prune).
#
# Per-node vars (NODE_RANK, MASTER_ADDR, HEADLESS, NCCL_IB_HCA,
# NCCL_SOCKET_IFNAME, VLLM_HOST_IP) are set by sparkrun, not here.
#
# Deliberate diffs vs deepseek-v4-flash-dspark.env:
#   - no VLLM_WORKER_MULTIPROC_METHOD (spawn default; fork was an aidendle94-
#     image workaround and this is the Stage-C image)
#   - no VLLM_ALLOW_LONG_MAX_MODEL_LEN (1M is the calibrated YaRN ceiling;
#     only needed if you push past 1M — don't)
#   - no DSPARK_SLOT_CLAMP / VLLM_TRITON_MLA_SPARSE tuning (aidendle94-lane
#     specific; not part of the validated Stage-C 0731 stack)

# --- HF / caches ---
HF_HUB_DISABLE_XET=1
TRITON_CACHE_DIR=/cache/huggingface/jitcache/triton
TORCH_EXTENSIONS_DIR=/cache/huggingface/jitcache/torch_extensions
VLLM_CACHE_DIR=/cache/huggingface/jitcache/vllm
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/jitcache/flashinfer
TVM_FFI_CACHE_DIR=/cache/huggingface/jitcache/tvm-ffi
XDG_CACHE_HOME=/cache/huggingface/jitcache

# --- vLLM runtime ---
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- FlashInfer sampler + B12X MoE ---
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
B12X_W4A16_TC_DECODE=0

# --- DSpark drafter switches (anti-garble set) ---
VLLM_DSPARK_GPU_REJECTED_CONTEXT_MASK=1
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_LOCAL_ARGMAX=1
VLLM_DSPARK_REPLICATE_MARKOV_W1=1
VLLM_DSPARK_FUSED_MARKOV_ARGMAX=0
VLLM_DSPARK_REFERENCE_KV_QUANT_DEQUANT=0
VLLM_DSV4_B12X_COMPRESSED_MLA=0
VLLM_DSV4_DSPARK_DEFER_TARGET_CAPTURE=0

# --- CUDA arch / JIT (GB10 = sm_121a) ---
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
# Stage-C keeps nvcc in the venv, NOT /usr/local/cuda (no toolkit there) —
# the usual path aborts DeepGEMM JIT with "std::filesystem::exists(nvcc_path)".
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc

# --- NCCL over the ConnectX-7 / IB-RoCE link ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
