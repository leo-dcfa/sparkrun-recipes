# Environment for MiMo-V2.5 NVFP4 Omni recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/MiaAI-Lab/MiMo-V2.5-vLLM-Dual-DGX-Sparks
#
# Mirrors the `env:` block of mimo-v2.5-omni.yaml. Per-node vars
# (NCCL_IB_HCA, NCCL_SOCKET_IFNAME, GLOO_SOCKET_IFNAME, node ranks) are set by
# sparkrun. No HF_TOKEN (sparkrun doesn't interpolate; containers run
# HF-offline — cache must be warm on BOTH nodes).

RAY_TMPDIR=/dev/shm/ray
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_WORKER_MULTIPROC_METHOD=fork
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# --- MiaAI NCCL tuning for the GB10 interconnect ---
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_PROTO=LL
NCCL_MAX_NCHANNELS=2
NCCL_NET_GDR_LEVEL=LOC
NCCL_DEBUG=WARN
