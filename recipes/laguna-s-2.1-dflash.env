# Environment for Laguna S 2.1 NVFP4 + DFlash recipe (DGX Spark GB10, 1 node)
# Source: https://github.com/MiaAI-Lab/Laguna-S-2.1-DGX-Spark-RTX-6000-PRO
#
# Mirrors the `env:` block of laguna-s-2.1-dflash.yaml so that docker/manual
# runs can take an --env-file. Keep the two in sync if you change anything.
#
# NB: no HF_TOKEN here — sparkrun does not interpolate env values (a literal
# ${HF_TOKEN} becomes a poisoned auth header), and the container runs HF-offline
# anyway. Pre-download the drafter on the host instead — see the yaml.

# --- MiaAI-Lab GB10 deploy (sm_121a) ---
CUTE_DSL_ARCH=sm_121a
# REQUIRED: cap JIT parallelism during the ~15 min first-start FlashInfer
# compile, or it exhausts unified memory. Still OOMs? MAX_JOBS=2, NVCC_THREADS=1.
MAX_JOBS=4
NVCC_THREADS=2
FLASHINFER_NVCC_THREADS=2

# --- CUDA arch (GB10 = sm_121a / Blackwell) — repo convention ---
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# --- Worker spawn method (only bites at TP=2, harmless at TP=1) ---
VLLM_WORKER_MULTIPROC_METHOD=fork

# --- NCCL over the ConnectX-7 IB link — only exercised if you run --tp 2 ---
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
