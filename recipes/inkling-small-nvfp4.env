# Environment for Inkling-Small NVFP4 SGLang+DSpark recipe (DGX Spark GB10, 2 nodes)
# Source: https://github.com/MiaAI-Lab/Inkling-Small-NVFP4-Dual-DGX-Sparks
#         (drowzeys champion runtime env, verbatim)
#
# Mirrors the `env:` block of inkling-small-nvfp4.yaml. Per-node vars
# (NCCL_IB_HCA, NCCL_SOCKET_IFNAME, GLOO_SOCKET_IFNAME, TP_SOCKET_IFNAME,
# node ranks) are set by sparkrun.
# NB: SGLANG_RAGGED_VERIFY_MODE must stay UNSET (compact crashes the sconv JIT).

INKLING_TORCH_CONV_COMMIT=1
INKLING_COMMIT_STEP_BIAS=1
INKLING_NOOP_CONV_COMMIT=0
INKLING_DRAFT_CTX_CAP=65536
SGLANG_ENABLE_UNIFIED_RADIX_TREE=1
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PYTHONWARNINGS=ignore::SyntaxWarning

# --- NCCL RoCE set (champion values; CROSS_NIC=0 unlike the vLLM lanes) ---
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
