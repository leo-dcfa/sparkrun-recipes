# Keys that turn MiaAI's DS4 DSpark .env.dspark into the 3-node lane's
# .env.dspark.tp3 (make deepseek-tp3-env; tools/env-overlay.py). 2026-09-29.
# Rank 2 = aitopatom-4b9d (Gigabyte AI TOP ATOM, GB10), reached from the head
# on link A. start-tp3.sh then moves Gloo/NCCL-socket/TP TCP onto enP7s7 and
# sets NCCL_IB_HCA to both CX7 ports on every rank; the WORKER2_* pins below are
# what it resolves the GID from first (the Atom's port facing the head, f1).
# MASTER_ADDR stays 10.100.200.2: the cx7-ring host routes make it answer on
# link A too. Weights: DSPARK_WORKER_HF_NFS=0 as on the pair — the Atom holds
# its own copy (seeded over CX7; make deepseek-tp3-prepare verifies it).
SERVED_MODEL_NAME=deepseek-v4-flash-vision-exp-tp3
WORKER2_HOST=10.100.210.3
WORKER2_VLLM_HOST_IP=10.100.210.3
WORKER2_NFS_SERVER_IP=10.100.210.2
WORKER2_NCCL_IB_HCA=rocep1s0f1
WORKER2_NCCL_SOCKET_IFNAME=enp1s0f1np1
WORKER2_TP_SOCKET_IFNAME=enp1s0f1np1
WORKER2_GLOO_SOCKET_IFNAME=enp1s0f1np1
